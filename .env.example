# Leave empty for local development; Vite proxies /api to port 8787.
VITE_API_BASE_URL=

# Supabase project connection. Publishable/anon key is safe for public RLS-protected reads.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Optional for public browsing; required only for privileged admin/storage operations.
SUPABASE_SERVICE_ROLE_KEY=

APP_URL=http://localhost:3000
PORT=8787
