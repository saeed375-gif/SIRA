# Leave empty for local development; Vite proxies /api to port 8787.
VITE_API_BASE_URL=

# Supabase project connection. Publishable/anon key is safe for public RLS-protected reads.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Optional for public browsing; required only for privileged admin/storage operations.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only key for the Sira intelligent guide. Never prefix this with VITE_.
GEMINI_API_KEY=
# Optional: change the assistant model without a code deploy.
GEMINI_MODEL=gemini-3.5-flash-lite
# Used automatically only when the primary model has a temporary capacity limit.
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

APP_URL=http://localhost:3000
PORT=8787
